{
  "name": "git-context",
  "displayName": "Git Context",
  "description": "Analyze git history and context",
  "version": "0.1.2",
  "publisher": "git-context",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/git-context.git"
  },
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=16.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:cockpit",
    "onView:bundle",
    "onView:commits",
    "onView:symbols",
    "onView:reports",
    "onCommand:git-context.*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-context.analyzeLastCommits",
        "title": "Analyze Last N Commits",
        "category": "Git Context"
      },
      {
        "command": "git-context.analyzeStagedChanges",
        "title": "Analyze Staged Changes",
        "category": "Git Context"
      },
      {
        "command": "git-context.compareFilesToCommit",
        "title": "Compare Files to Commit",
        "category": "Git Context"
      },
      {
        "command": "git-context.searchSymbols",
        "title": "Search Symbols",
        "category": "Git Context"
      },
      {
        "command": "git-context.generateReport",
        "title": "Generate Commit Analysis Report",
        "category": "Git Context",
        "icon": "$(file-text)"
      },
      {
        "command": "git-context.analyze",
        "title": "Analyze",
        "category": "Git Context",
        "icon": "$(play)"
      },
      {
        "command": "git-context.viewLatestReport",
        "title": "View Report",
        "category": "Git Context",
        "icon": "$(file-text)"
      },
      {
        "command": "git-context.openReport",
        "title": "Open Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.regenerateReport",
        "title": "Regenerate Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.deleteReport",
        "title": "Delete Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.toggleFileSelection",
        "title": "Toggle File Selection",
        "category": "Git Context"
      },
      {
        "command": "git-context.toggleSelection",
        "title": "Toggle Selection",
        "category": "Git Context"
      },
      {
        "command": "git-context.togglePinReport",
        "title": "Toggle Pin Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.addCommitBySha",
        "title": "Add Commit by SHA",
        "category": "Git Context"
      },
      {
        "command": "git-context.addMoreCommits",
        "title": "Add More Commits",
        "category": "Git Context"
      },
      {
        "command": "git-context.openReportSection",
        "title": "Open Report Section",
        "category": "Git Context"
      },
      {
        "command": "git-context.selectAllStaged",
        "title": "Select All Staged",
        "category": "Git Context"
      },
      {
        "command": "git-context.selectAllUnstaged",
        "title": "Select All Unstaged",
        "category": "Git Context"
      },
      {
        "command": "git-context.exportLlmContext",
        "title": "Export LLM Context (JSON)",
        "category": "Git Context",
        "icon": "$(export)"
      },
      {
        "command": "git-context.toggleCommitSelection",
        "title": "Toggle Selection",
        "icon": "$(check)"
      },
      {
        "command": "git-context.clearSelection",
        "title": "Clear Selection",
        "category": "Git Context"
      },
      {
        "command": "git-context.resetAll",
        "title": "Reset All",
        "category": "Git Context",
        "icon": "$(trash)"
      },
      {
        "command": "git-context.pullLatest",
        "title": "Pull Latest Commits",
        "category": "Git Context"
      },
      {
        "command": "git-context.bundle.regenerate",
        "title": "Bundle: Regenerate",
        "icon": "$(refresh)"
      },
      {
        "command": "git-context.bundle.clear",
        "title": "Bundle: Clear",
        "icon": "$(clear-all)"
      },
      {
        "command": "git-context.bundle.cancel",
        "title": "Bundle: Cancel Analysis",
        "icon": "$(stop)"
      },
      {
        "command": "git-context.bundle.addCommit",
        "title": "Bundle: Add Commit",
        "icon": "$(add)"
      },
      {
        "command": "git-context.bundle.removeCommit",
        "title": "Bundle: Remove Commit",
        "icon": "$(remove)"
      },
      {
        "command": "git-context.bundle.export",
        "title": "Bundle: Export Context",
        "icon": "$(export)"
      },
      {
        "command": "commit-tracker.regenerateBundle",
        "title": " ",
        "enablement": "false"
      },
      {
        "command": "commit-tracker.clearBundle",
        "title": " ",
        "enablement": "false"
      },
      {
        "command": "commit-tracker.cancelAnalysis",
        "title": " ",
        "enablement": "false"
      },
      {
        "command": "commit-tracker.addToBundle",
        "title": " ",
        "enablement": "false"
      },
      {
        "command": "commit-tracker.removeFromBundle",
        "title": " ",
        "enablement": "false"
      },
      {
        "command": "git-context.findSimilarCommits",
        "title": "Find Similar Commits",
        "category": "Git Context",
        "icon": "$(search)"
      },
      {
        "command": "git-context.searchCommitsSemantic",
        "title": "Search Commits (Semantic)",
        "category": "Git Context",
        "icon": "$(search)"
      },
      {
        "command": "git-context.findSimilarSymbols",
        "title": "Find Similar Symbols",
        "category": "Git Context",
        "icon": "$(symbol-method)"
      },
      {
        "command": "git-context.findConventionDrift",
        "title": "Find Convention Drift",
        "category": "Git Context",
        "icon": "$(symbol-constant)"
      },
      {
        "command": "git-context.showConventionTimeline",
        "title": "Show Convention Timeline",
        "category": "Git Context",
        "icon": "$(timeline)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitContext",
          "title": "Git Context",
          "icon": "resources/git-context.svg"
        }
      ]
    },
    "views": {
      "gitContext": [
        {
          "id": "cockpit",
          "name": "Cockpit",
          "type": "webview"
        },
        {
          "id": "bundle",
          "name": "Active Bundle",
          "type": "tree"
        },
        {
          "id": "commits",
          "name": "Commits",
          "type": "tree",
          "showCollapseAll": true
        },
        {
          "id": "symbols",
          "name": "Symbols",
          "type": "tree"
        },
        {
          "id": "reports",
          "name": "Reports",
          "type": "tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "git-context.bundle.regenerate",
          "when": "view == bundle && gitContext.hasActiveBundle",
          "group": "navigation@1"
        },
        {
          "command": "git-context.bundle.clear",
          "when": "view == bundle && gitContext.hasActiveBundle",
          "group": "navigation@2"
        },
        {
          "command": "git-context.bundle.export",
          "when": "view == bundle && gitContext.hasActiveBundle",
          "group": "navigation@3"
        },
        {
          "command": "git-context.analyze",
          "when": "view == commits",
          "group": "navigation@1"
        },
        {
          "command": "git-context.viewLatestReport",
          "when": "view == reports",
          "group": "navigation@1"
        },
        {
          "command": "git-context.searchSymbols",
          "when": "view == symbols",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "git-context.toggleCommitSelection",
          "when": "view == commits && (viewItem == gitContextCommit || viewItem == gitContextCommitInBundle)",
          "group": "inline@1"
        },
        {
          "command": "git-context.bundle.addCommit",
          "when": "view == commits && viewItem == gitContextCommit",
          "group": "bundle@1"
        },
        {
          "command": "git-context.bundle.removeCommit",
          "when": "view == commits && viewItem == gitContextCommitInBundle",
          "group": "bundle@1"
        },
        {
          "command": "git-context.compareFilesToCommit",
          "when": "view == commits && (viewItem == gitContextCommit || viewItem == gitContextCommitInBundle)",
          "group": "analysis@1"
        },
        {
          "command": "git-context.selectAllStaged",
          "when": "view == commits && viewItem == gitContextSelectionStaged",
          "group": "selection@1"
        },
        {
          "command": "git-context.selectAllUnstaged",
          "when": "view == commits && viewItem == gitContextSelectionUnstaged",
          "group": "selection@2"
        },
        {
          "command": "git-context.pullLatest",
          "when": "view == commits && viewItem == gitContextSelectionHeader",
          "group": "inline@1"
        },
        {
          "command": "git-context.resetAll",
          "when": "view == commits && viewItem == gitContextSelectionHeader",
          "group": "inline@2"
        },
        {
          "command": "git-context.addMoreCommits",
          "when": "view == commits && viewItem == gitContextActionLoadMore",
          "group": "inline@1"
        },
        {
          "command": "git-context.addCommitBySha",
          "when": "view == commits && viewItem == gitContextActionAddBySha",
          "group": "inline@1"
        },
        {
          "command": "git-context.openReport",
          "when": "view == reports && viewItem == gitContextReport",
          "group": "inline@1"
        },
        {
          "command": "git-context.deleteReport",
          "when": "view == reports && viewItem == gitContextReport",
          "group": "modification@2"
        },
        {
          "command": "git-context.bundle.regenerate",
          "when": "view == bundle && viewItem == gitContextActiveBundle",
          "group": "modification@1"
        },
        {
          "command": "git-context.bundle.clear",
          "when": "view == bundle && viewItem == gitContextActiveBundle",
          "group": "modification@2"
        },
        {
          "command": "git-context.bundle.export",
          "when": "view == bundle && viewItem == gitContextActiveBundle",
          "group": "export@1"
        }
      ]
    },
    "configuration": {
      "title": "Git Context",
      "properties": {
        "git-context.openRouterApiKey": {
          "type": "string",
          "description": "OpenRouter API key for LLM summarization"
        },
        "git-context.openRouterModel": {
          "type": "string",
          "default": "anthropic/claude-3-haiku:beta",
          "description": "OpenRouter model to use for summarization"
        },
        "git-context.apiEndpoint": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "API endpoint for LLM requests (OpenRouter or Ollama)"
        },
        "git-context.difftasticPath": {
          "type": "string",
          "description": "Path to difftastic binary (auto-detected if not set)"
        },
        "git-context.defaultCommitCount": {
          "type": "number",
          "default": 5,
          "description": "Default number of commits to analyze"
        },
        "git-context.tokensPerStep": {
          "type": "object",
          "default": {},
          "description": "Custom token limits per analysis step (e.g. {\"discovery\": 8000})"
        },
        "git-context.customPrompts": {
          "type": "object",
          "default": {},
          "description": "Custom prompt overrides per step (e.g. {\"discovery\": \"...\"})"
        },
        "git-context.customIgnorePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional paths to ignore during analysis (glob patterns)"
        },
        "git-context.qdrantUrl": {
          "type": "string",
          "default": "",
          "description": "Qdrant server URL (e.g., http://localhost:6333). Leave blank for local instance."
        },
        "git-context.qdrantApiKey": {
          "type": "string",
          "default": "",
          "description": "Qdrant API key (required for cloud instances, optional for local)"
        },
        "git-context.embeddingProvider": {
          "type": "string",
          "default": "",
          "description": "Embedding API endpoint (e.g., https://api.openai.com/v1). Leave blank to use the same provider as LLM."
        },
        "git-context.embeddingModel": {
          "type": "string",
          "default": "text-embedding-3-small",
          "description": "Embedding model to use (e.g., text-embedding-3-small, text-embedding-ada-002)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node copy-wasm.js && node download-wasm.js && npm run build:cockpit",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "build:cockpit": "esbuild src/webview/cockpit/index.tsx --bundle --outfile=media/cockpit.js --format=iife --platform=browser --loader:.tsx=tsx --loader:.ts=ts --jsx=automatic --sourcemap",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.31.0",
    "react": "^18.0.0",
    "react-dom": "^18.3.1",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.16.0",
    "chalk": "^4.1.2",
    "commander": "^10.0.0",
    "openai": "^4.0.0",
    "sql.js": "^1.13.0",
    "web-tree-sitter": "^0.25.10"
  },
  "bin": {
    "ct": "./out/cli/index.js"
  }
}

{
  "name": "git-context",
  "displayName": "Git Context",
  "description": "Analyze git history and context",
  "version": "0.1.2",
  "publisher": "git-context",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/git-context.git"
  },
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=16.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:commitTracker"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-context.analyzeLastCommits",
        "title": "Analyze Last N Commits",
        "category": "Git Context"
      },
      {
        "command": "git-context.analyzeStagedChanges",
        "title": "Analyze Staged Changes",
        "category": "Git Context"
      },
      {
        "command": "git-context.compareFilesToCommit",
        "title": "Compare Files to Commit",
        "category": "Git Context"
      },
      {
        "command": "git-context.searchSymbols",
        "title": "Search Symbols",
        "category": "Git Context"
      },
      {
        "command": "git-context.generateReport",
        "title": "Generate Commit Analysis Report",
        "category": "Git Context",
        "icon": "$(file-text)"
      },
      {
        "command": "git-context.exportLlmContext",
        "title": "Export LLM Context (JSON)",
        "category": "Git Context",
        "icon": "$(export)"
      },
      {
        "command": "git-context.toggleCommitSelection",
        "title": "Toggle Selection",
        "icon": "$(check)"
      },
      {
        "command": "git-context.clearSelection",
        "title": "Clear Selection",
        "category": "Git Context"
      },
      {
        "command": "commit-tracker.regenerateBundle",
        "title": "Regenerate Bundle",
        "icon": "$(refresh)"
      },
      {
        "command": "commit-tracker.clearBundle",
        "title": "Clear Bundle",
        "icon": "$(clear-all)"
      },
      {
        "command": "commit-tracker.cancelAnalysis",
        "title": "Cancel Analysis",
        "icon": "$(stop)"
      },
      {
        "command": "commit-tracker.addToBundle",
        "title": "Add to Current Bundle",
        "icon": "$(add)"
      },
      {
        "command": "commit-tracker.removeFromBundle",
        "title": "Remove from Bundle",
        "icon": "$(remove)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commit-tracker",
          "title": "Commit Tracker",
          "icon": "$(git-commit)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "symbolHistory",
          "name": "Symbol History",
          "icon": "$(search)",
          "contextualTitle": "Symbol History",
          "visibility": "visible"
        }
      ],
      "commit-tracker": [
        {
          "id": "commitTracker",
          "name": "Refactor Intelligence",
          "type": "tree",
          "showCollapseAll": true
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "git-context.analyzeLastCommits",
          "when": "view == commitTracker",
          "group": "navigation"
        },
        {
          "command": "git-context.generateReport",
          "when": "view == commitTracker",
          "group": "navigation"
        },
        {
          "command": "git-context.clearSelection",
          "when": "view == commitTracker",
          "group": "navigation"
        },
        {
          "command": "git-context.searchSymbols",
          "when": "view == symbolHistory",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "git-context.toggleCommitSelection",
          "when": "view == commitTracker && viewItem == commit",
          "group": "inline"
        },
        {
          "command": "commit-tracker.addToBundle",
          "when": "view == commitTracker && viewItem == commit && !inRefactorBundle",
          "group": "7_modification"
        },
        {
          "command": "commit-tracker.removeFromBundle",
          "when": "view == commitTracker && viewItem == commit && inRefactorBundle",
          "group": "7_modification"
        },
        {
          "command": "git-context.compareFilesToCommit",
          "when": "view == commitTracker && viewItem == commit",
          "group": "8_analysis"
        },
        {
          "command": "commit-tracker.regenerateBundle",
          "when": "view == commitTracker && viewItem == activeBundle",
          "group": "7_modification"
        },
        {
          "command": "commit-tracker.clearBundle",
          "when": "view == commitTracker && viewItem == activeBundle",
          "group": "7_modification"
        },
        {
          "command": "git-context.exportLlmContext",
          "when": "view == commitTracker && viewItem == activeBundle",
          "group": "8_analysis"
        }
      ]
    },
    "configuration": {
      "title": "Git Context",
      "properties": {
        "git-context.openRouterApiKey": {
          "type": "string",
          "description": "OpenRouter API key for LLM summarization"
        },
        "git-context.openRouterModel": {
          "type": "string",
          "default": "anthropic/claude-3-haiku:beta",
          "description": "OpenRouter model to use for summarization"
        },
        "git-context.apiEndpoint": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "API endpoint for LLM requests (OpenRouter or Ollama)"
        },
        "git-context.difftasticPath": {
          "type": "string",
          "description": "Path to difftastic binary (auto-detected if not set)"
        },
        "git-context.defaultCommitCount": {
          "type": "number",
          "default": 5,
          "description": "Default number of commits to analyze"
        },
        "git-context.tokensPerStep": {
          "type": "object",
          "default": {},
          "description": "Custom token limits per analysis step (e.g. {\"discovery\": 8000})"
        },
        "git-context.customPrompts": {
          "type": "object",
          "default": {},
          "description": "Custom prompt overrides per step (e.g. {\"discovery\": \"...\"})"
        },
        "git-context.customIgnorePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional paths to ignore during analysis (glob patterns)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node copy-wasm.js && node download-wasm.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.31.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^10.0.0",
    "openai": "^4.0.0",
    "sql.js": "^1.13.0",
    "web-tree-sitter": "^0.25.10"
  },
  "bin": {
    "ct": "./out/cli/index.js"
  }
}

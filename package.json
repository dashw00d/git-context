{
  "name": "git-context",
  "displayName": "Git Context",
  "description": "Analyze git history and context",
  "version": "0.1.2",
  "publisher": "git-context",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/git-context.git"
  },
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=16.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:git-context.*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-context.analyzeLastCommits",
        "title": "Analyze Last N Commits",
        "category": "Git Context"
      },
      {
        "command": "git-context.analyzeStagedChanges",
        "title": "Analyze Staged Changes",
        "category": "Git Context"
      },
      {
        "command": "git-context.analyzeUnstagedChanges",
        "title": "Analyze Unstaged Changes",
        "category": "Git Context"
      },
      {
        "command": "git-context.generateReport",
        "title": "Generate Commit Analysis Report",
        "category": "Git Context",
        "icon": "$(file-text)"
      },
      {
        "command": "git-context.openReport",
        "title": "Open Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.deleteReport",
        "title": "Delete Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.togglePinReport",
        "title": "Toggle Pin Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.toggleCommitSelection",
        "title": "Toggle Commit Selection",
        "category": "Git Context"
      },
      {
        "command": "git-context.clearSelection",
        "title": "Clear Selection",
        "category": "Git Context"
      },
      {
        "command": "git-context.toggleBranchFilter",
        "title": "Toggle Branch Filter",
        "category": "Git Context"
      },
      {
        "command": "git-context.bundle.regenerate",
        "title": "Bundle: Regenerate",
        "icon": "$(refresh)"
      },
      {
        "command": "git-context.bundle.clear",
        "title": "Bundle: Clear",
        "icon": "$(clear-all)"
      },
      {
        "command": "git-context.bundle.cancel",
        "title": "Bundle: Cancel Analysis",
        "icon": "$(stop)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitContext",
          "title": "Git Context",
          "icon": "resources/git-context.svg"
        }
      ]
    },
    "views": {
      "gitContext": [
        {
          "id": "cockpit",
          "name": "Cockpit",
          "type": "webview"
        }
      ]
    },
    "menus": {},
    "configuration": {
      "title": "Git Context",
      "properties": {
        "git-context.openRouterApiKey": {
          "type": "string",
          "description": "OpenRouter API key for LLM summarization"
        },
        "git-context.openRouterModel": {
          "type": "string",
          "default": "anthropic/claude-3-haiku:beta",
          "description": "OpenRouter model to use for summarization"
        },
        "git-context.apiEndpoint": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "API endpoint for LLM requests (OpenRouter or Ollama)"
        },
        "git-context.difftasticPath": {
          "type": "string",
          "description": "Path to difftastic binary (auto-detected if not set)"
        },
        "git-context.defaultCommitCount": {
          "type": "number",
          "default": 5,
          "description": "Default number of commits to analyze"
        },
        "git-context.tokensPerStep": {
          "type": "object",
          "default": {},
          "description": "Custom token limits per analysis step (e.g. {\"discovery\": 8000})"
        },
        "git-context.customPrompts": {
          "type": "object",
          "default": {},
          "description": "Custom prompt overrides per step (e.g. {\"discovery\": \"...\"})"
        },
        "git-context.customIgnorePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional paths to ignore during analysis (glob patterns)"
        },
        "git-context.qdrantUrl": {
          "type": "string",
          "default": "",
          "description": "Qdrant server URL (e.g., http://localhost:6333). Leave blank for local instance."
        },
        "git-context.qdrantApiKey": {
          "type": "string",
          "default": "",
          "description": "Qdrant API key (required for cloud instances, optional for local)"
        },
        "git-context.embeddingProvider": {
          "type": "string",
          "default": "",
          "description": "Embedding API endpoint (e.g., https://api.openai.com/v1). Leave blank to use the same provider as LLM."
        },
        "git-context.embeddingModel": {
          "type": "string",
          "default": "text-embedding-3-small",
          "description": "Embedding model to use (e.g., text-embedding-3-small, text-embedding-ada-002)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node copy-wasm.js && node download-wasm.js && npm run build:cockpit",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "build:cockpit": "esbuild src/webview/cockpit/index.tsx --bundle --outfile=media/cockpit.js --format=iife --platform=browser --loader:.tsx=tsx --loader:.ts=ts --jsx=automatic --sourcemap",
    "test": "echo \"No tests configured\""
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.57.1",
    "react": "^18.0.0",
    "react-dom": "^18.3.1",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.16.0",
    "@types/lodash": "^4.17.21",
    "chalk": "^4.1.2",
    "commander": "^10.0.0",
    "lodash": "^4.17.21",
    "openai": "^4.0.0",
    "sql.js": "^1.13.0",
    "web-tree-sitter": "^0.25.10"
  },
  "bin": {
    "ct": "./out/cli/index.js"
  }
}

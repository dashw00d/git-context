{
  "name": "git-context",
  "displayName": "Git Context",
  "description": "Analyze git history and context",
  "version": "2.0.0",
  "publisher": "git-context",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/git-context.git"
  },
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=16.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:git-context.*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-context.analyzeLastCommits",
        "title": "Analyze Last N Commits",
        "category": "Git Context"
      },
      {
        "command": "git-context.analyzeStagedChanges",
        "title": "Analyze Staged Changes",
        "category": "Git Context"
      },
      {
        "command": "git-context.analyzeUnstagedChanges",
        "title": "Analyze Unstaged Changes",
        "category": "Git Context"
      },
      {
        "command": "git-context.generateReport",
        "title": "Generate Commit Analysis Report",
        "category": "Git Context",
        "icon": "$(file-text)"
      },
      {
        "command": "git-context.openReport",
        "title": "Open Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.deleteReport",
        "title": "Delete Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.togglePinReport",
        "title": "Toggle Pin Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.toggleCommitSelection",
        "title": "Toggle Commit Selection",
        "category": "Git Context"
      },
      {
        "command": "git-context.clearSelection",
        "title": "Clear Selection",
        "category": "Git Context"
      },
      {
        "command": "git-context.toggleBranchFilter",
        "title": "Toggle Branch Filter",
        "category": "Git Context"
      },
      {
        "command": "git-context.bundle.regenerate",
        "title": "Bundle: Regenerate",
        "icon": "$(refresh)"
      },
      {
        "command": "git-context.bundle.clear",
        "title": "Bundle: Clear",
        "icon": "$(clear-all)"
      },
      {
        "command": "git-context.bundle.cancel",
        "title": "Bundle: Cancel Analysis",
        "icon": "$(stop)"
      },
      {
        "command": "git-context.exportContext",
        "title": "Export Context (JSON + Mermaid)",
        "category": "Git Context",
        "icon": "$(file-code)"
      },
      {
        "command": "git-context.generateLiveReport",
        "title": "Generate Live Analysis Report",
        "category": "Git Context"
      },
      {
        "command": "git-context.downloadWasmFiles",
        "title": "Download Required WASM Files",
        "category": "Git Context",
        "icon": "$(cloud-download)"
      },
      {
        "command": "git-context.superReport",
        "title": "Open Super Report (Facts-First)",
        "category": "Git Context",
        "icon": "$(preview)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitContext",
          "title": "Git Context",
          "icon": "resources/git-context.svg"
        }
      ]
    },
    "views": {
      "gitContext": [
        {
          "id": "cockpit",
          "name": "Cockpit",
          "type": "webview"
        },
        {
          "id": "gitContext.refactorReport",
          "name": "Refactor Report",
          "type": "webview",
          "visibility": "hidden"
        }
      ]
    },
    "menus": {},
    "configuration": {
      "title": "Git Context",
      "properties": {
        "git-context.openRouterApiKey": {
          "type": "string",
          "description": "OpenRouter API key for LLM summarization",
          "default": "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"
        },
        "git-context.openRouterModel": {
          "type": "string",
          "default": "x-ai/grok-4.1-fast:free",
          "description": "OpenRouter model to use for summarization"
        },
        "git-context.apiEndpoint": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "API endpoint for LLM requests (OpenRouter or Ollama)"
        },
        "git-context.difftasticPath": {
          "type": "string",
          "description": "Path to difftastic binary (auto-detected if not set)"
        },
        "git-context.defaultCommitCount": {
          "type": "number",
          "default": 5,
          "description": "Default number of commits to analyze"
        },
        "git-context.tokensPerStep": {
          "type": "object",
          "default": {
            "default": 4000,
            "intent": 4000,
            "drift": 4000,
            "cleanup": 4000,
            "discover": 8000,
            "quantify": 8000,
            "plan": 8000,
            "summary": 4000
          },
          "description": "Custom token limits per analysis step. Keys: default, intent, drift, cleanup, discover, quantify, plan, summary"
        },
        "git-context.customPrompts": {
          "type": "object",
          "default": {},
          "description": "Custom prompt overrides per step (e.g. {\"discovery\": \"...\"})"
        },
        "git-context.customIgnorePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional paths to ignore during analysis (glob patterns)"
        },
        "git-context.qdrantUrl": {
          "type": "string",
          "default": "http://localhost:6333",
          "description": "Qdrant server URL (e.g., http://localhost:6333). Leave blank for local instance."
        },
        "git-context.qdrantApiKey": {
          "type": "string",
          "default": "",
          "description": "Qdrant API key (required for cloud instances, optional for local)"
        },
        "git-context.embeddingProvider": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "Embedding API endpoint (e.g., https://api.openai.com/v1). Leave blank to use the same provider as LLM."
        },
        "git-context.embeddingModel": {
          "type": "string",
          "default": "openai/text-embedding-3-small",
          "description": "Embedding model to use (e.g., text-embedding-3-small, text-embedding-ada-002)"
        },
        "git-context.allowedExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "php",
            "js",
            "ts",
            "tsx",
            "jsx",
            "json",
            "md",
            "css"
          ],
          "description": "File extensions to analyze. Missing WASM files will be automatically downloaded when you add new extensions. Supported: js, ts, tsx, jsx, php, vue, svelte, py, go, rust, java, c, cpp, cs, rb, scala, kotlin, swift, yaml, toml, md, dockerfile, html, css, json, bash"
        },
        "git-context.maxFileSize": {
          "type": "number",
          "default": 102400,
          "description": "Maximum file size in bytes to analyze (default: 100KB)"
        },
        "git-context.perProjectQdrantCollections": {
          "type": "boolean",
          "default": true,
          "description": "Use separate Qdrant collections per project for isolation"
        },
        "git-context.enableCstTracking": {
          "type": "boolean",
          "default": true,
          "description": "Enable CST-only tracking for languages without semantic symbols (markdown, json, yaml, css)"
        },
        "git-context.enableCstAugmentation": {
          "type": "boolean",
          "default": true,
          "description": "Enable hybrid augmentation: layer structural facts (comments, docstrings) on top of semantic symbols for supported languages"
        },
        "git-context.cstLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "markdown",
            "json",
            "yaml",
            "css"
          ],
          "description": "Languages to treat as CST-only (structural tracking only, no semantic symbols)"
        },
        "git-context.live.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable live change tracking"
        },
        "git-context.live.thresholds.lines": {
          "type": "number",
          "default": 50,
          "description": "Minimum lines changed to trigger analysis"
        },
        "git-context.live.thresholds.symbols": {
          "type": "number",
          "default": 5,
          "description": "Minimum symbols changed to trigger analysis"
        },
        "git-context.live.extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "php",
            "js",
            "ts",
            "tsx",
            "jsx",
            "json",
            "md",
            "css"
          ],
          "description": "File extensions for live tracking (defaults to supported languages)"
        },
        "git-context.live.autoRunAfterEdits": {
          "type": "number",
          "default": 50,
          "description": "Auto-run analysis after N edits (0 to disable auto-run)"
        },
        "git-context.snapshotCacheEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable snapshot caching for faster pipeline performance"
        },
        "git-context.snapshotCacheSize": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of snapshots to cache in memory"
        },
        "git-context.snapshotCacheTTL": {
          "type": "number",
          "default": 3600,
          "description": "Snapshot cache TTL in seconds (default: 1 hour)"
        },
        "git-context.detectorThresholds": {
          "type": "object",
          "properties": {
            "similarityMin": {
              "type": "number",
              "default": 0.7,
              "description": "Minimum similarity score (0.0-1.0) for detector algorithms"
            },
            "confidenceMin": {
              "type": "number",
              "default": 0.5,
              "description": "Minimum confidence score (0.0-1.0) for detector algorithms"
            },
            "changeThreshold": {
              "type": "number",
              "default": 3,
              "description": "Minimum change count for significance in detector algorithms"
            },
            "maxGroupSize": {
              "type": "number",
              "default": 1000,
              "description": "Maximum size of groups to process in detector algorithms"
            },
            "scoreWeight": {
              "type": "number",
              "default": 1,
              "description": "Weight multiplier for scoring in detector algorithms"
            }
          },
          "description": "Threshold configuration for detector algorithms (BaseDetector)"
        },
        "git-context.bundleConfig": {
          "type": "object",
          "default": {
            "mode": "repo",
            "roots": [],
            "includeConnected": false,
            "exclusions": []
          },
          "description": "Configuration for the Bundle Scope (mode, roots, exclusions)",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "repo",
                "module",
                "changes",
                "custom"
              ],
              "default": "repo",
              "description": "Scope mode: repo (full), module (current), changes (staged/unstaged), or custom"
            },
            "roots": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "Custom root paths for 'custom' mode"
            },
            "includeConnected": {
              "type": "boolean",
              "default": false,
              "description": "Include connected files (callers/callees)"
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "Glob patterns to exclude"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/copy-wasm.js && node scripts/download-wasm.js && npm run build:cockpit",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:errors": "eslint src --ext ts --quiet",
    "lint:fix": "eslint src --ext ts --fix",
    "build:cockpit": "esbuild src/webview/cockpit/index.tsx --bundle --outfile=media/cockpit.js --format=iife --platform=browser --loader:.tsx=tsx --loader:.ts=ts --jsx=automatic --sourcemap",
    "test": "vitest --reporter=json --reporter=default",
    "test:watch": "vitest --watch",
    "test:pipeline": "npx ts-node benchmarks/pipeline_metric_test.ts --shared-state",
    "test:pipeline:ci": "node -e \"const cp = require('child_process'); const result = cp.spawnSync('npx', ['ts-node', 'benchmarks/pipeline_metric_test.ts', '--shared-state'], { stdio: 'pipe', encoding: 'utf8' }); console.log(result.stdout); const accuracyMatch = result.stdout.match(/Overall Accuracy: ([\\d.]+)%/); if (accuracyMatch && parseFloat(accuracyMatch[1]) < 85) { console.error('❌ Pipeline test accuracy below 85% threshold'); process.exit(1); } else if (accuracyMatch) { console.log('✅ Pipeline test accuracy meets 85% threshold'); } else { console.log('⚠️  Could not parse accuracy from test output'); process.exit(1); }\"",
    "clean:compiled": "find src -name \"*.js\" -o -name \"*.js.map\" -print -delete && rm -rf out",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.19.25",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.3",
    "react": "^18.0.0",
    "react-dom": "^18.3.1",
    "typescript": "^4.9.4",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.16.0",
    "@types/lodash": "^4.17.21",
    "chalk": "^4.1.2",
    "commander": "^10.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "ignore": "^7.0.5",
    "lodash": "^4.17.21",
    "lru-cache": "^10.4.3",
    "openai": "^4.0.0",
    "p-limit": "^3.1.0",
    "simple-git": "^3.30.0",
    "sql.js": "^1.13.0",
    "undici": "^5.0.0",
    "web-tree-sitter": "^0.25.10"
  },
  "bin": {
    "ct": "./out/cli/index.js"
  }
}
